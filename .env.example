# ค่าทั้งสองเป็น Public Project URL และ Public anon key เท่านั้น
# ห้ามใส่ service_role key หรือ database password ในไฟล์ฝั่งเว็บ
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ไม่ต้องตั้งค่าสำหรับ GitHub Project Pages ปกติ ระบบตรวจชื่อ repository ให้อัตโนมัติ
# ใช้ / เฉพาะเมื่อ deploy บน custom domain
# VITE_BASE_PATH=/
